# Copy to .env for local development. Every variable is documented in docs/CONVENTIONS.md.
# Values here are LOCAL placeholders only — never production credentials.

APP_ENV=dev
LOG_LEVEL=info

# --- docker-compose services (all bound to 127.0.0.1) -------------------------
POSTGRES_USER=goalstream
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=goalstream
MINIO_ROOT_USER=goalstream
MINIO_ROOT_PASSWORD=change-me-local-minio

DATABASE_URL=postgres://goalstream:change-me-local@127.0.0.1:5442/goalstream?sslmode=disable
TEST_DATABASE_URL=postgres://goalstream:change-me-local@127.0.0.1:5442/goalstream_test?sslmode=disable
REDIS_URL=redis://127.0.0.1:6380/0

# --- object storage (MinIO locally, R2 in production — config only) ----------
S3_ENDPOINT=http://127.0.0.1:9010
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=goalstream
S3_TEST_BUCKET=goalstream-test
S3_ACCESS_KEY=goalstream
S3_SECRET_KEY=change-me-local-minio
S3_USE_PATH_STYLE=true
PRESIGN_TTL=15m

# --- ingest --------------------------------------------------------------------
DATA_DIR=./data
INGEST_LABELS=Goal
PRE_ROLL_SECONDS=15
POST_ROLL_SECONDS=45
MIN_CLIP_SECONDS=30
MEZZ_CRF=18
MEZZ_MAXRATE=8000000
INGEST_CUT_TIMEOUT=5m
TAGS_TODO_PATH=./tags_todo.csv

# --- api ------------------------------------------------------------------------
HTTP_ADDR=:8080
AUTH_MODE=dev
DEV_USER_EMAIL=dev@localhost
# AUTH_MODE=jwt only: ≥ 32 bytes (openssl rand -base64 48). Never reuse INVITE_SECRET.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# a rotated refresh token replayed within this window is a tab race, not theft
REFRESH_REUSE_GRACE=30s
# false only because local is plain http; refused outside APP_ENV=dev
COOKIE_SECURE=false
GATE_ENABLED=true
INVITE_CODES=local:let-me-in
INVITE_SECRET=local-invite-secret-at-least-32-bytes
INVITE_TTL=720h
CLIENT_IP_HEADER=

# Recommender (plan §11)
EXPLORE_RATE=0.3
# liked + disliked below this → cold: uniform random, no centroid query
COLD_START_THRESHOLD=5
RECO_TOP_K=50
NEG_PENALTY=0.5

# --- worker (M5: `make worker JOB=<id>`; queue + reaper settings arrive in M6) ------
# per-attempt temp dirs; empty = the OS temp dir
WORK_DIR=
TRANSCODE_TIMEOUT=10m
MAX_TRANSCODE_ATTEMPTS=3
UPLOAD_CONCURRENCY=4
